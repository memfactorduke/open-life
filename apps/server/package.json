{
  "name": "@mems-life/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli.ts migrate",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "recover": "tsx src/cli.ts recover",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@fastify/cors": "11.2.0",
    "@fastify/static": "10.1.6",
    "@mems-life/domain": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "kysely": "0.28.17",
    "pg": "8.20.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.18.0"
  }
}
